# ============================================================
# Robinhood Uniswap Bot — variables d'environnement
# ============================================================
# 1) Copier ce fichier :
#      cp .env.example .env
# 2) Remplir UNIQUEMENT dans .env (jamais committer .env)
# ============================================================

# --- Authentification (à renseigner localement dans .env) ---
# Dashboard: https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=

# Clé privée du wallet de trading (0x… ) — wallet dédié recommandé
PRIVATE_KEY=

# --- Réseau Robinhood Chain ---
# Mainnet RPC public (ou Alchemy / Chainstack pour plus de fiabilité)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# 4663 = mainnet | 46630 = testnet
CHAIN_ID=4663

# Optionnel — override de l'URL API Uniswap
# UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1

# --- Swap ---
# Slippage en % (tokens pools.trade souvent volatils → 1 à 3)
SLIPPAGE_TOLERANCE=1.0
# BEST_PRICE | FASTEST | BEST_PRICE_FASTEST
ROUTING_PREFERENCE=BEST_PRICE
# true = construit la tx sans la broadcaster
DRY_RUN=false

# --- PnL / Take-profit auto ---
# 100 = vendre tout quand la valeur = x2 (+100 % de profit)
TAKE_PROFIT_PCT=100
# Intervalle de poll (secondes) pour `watch-pnl`
PNL_POLL_INTERVAL=10

# Optionnel — chemin du fichier positions
# POSITIONS_PATH=./data/positions.json
