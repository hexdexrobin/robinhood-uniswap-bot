# === Uniswap Trading API ===
# Créer une clé sur https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=your_uniswap_api_key_here

# === Wallet (NE JAMAIS committer ce fichier) ===
# Clé privée du wallet qui exécute les swaps (sans 0x ou avec 0x)
PRIVATE_KEY=0x_your_private_key_here

# === Robinhood Chain RPC ===
# Public: https://rpc.mainnet.chain.robinhood.com
# Ou Alchemy / Chainstack pour plus de fiabilité
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# === Paramètres de swap par défaut ===
# Chain ID Robinhood Chain mainnet = 4663 (testnet = 46630)
CHAIN_ID=4663

# Slippage en % (ex: 0.5 = 0.5%, 1 = 1%). Tokens pools.trade souvent volatils → 1–3%
SLIPPAGE_TOLERANCE=1.0

# Préférence de routage: BEST_PRICE | FASTEST | BEST_PRICE_FASTEST
ROUTING_PREFERENCE=BEST_PRICE

# true = dry-run (quote + tx construite, pas de broadcast)
DRY_RUN=false

# === PnL / Take-profit auto ===
# 100 = vendre tout quand la valeur atteint x2 ( +100% de profit )
TAKE_PROFIT_PCT=100
# Intervalle de poll en secondes pour watch-pnl
PNL_POLL_INTERVAL=10

